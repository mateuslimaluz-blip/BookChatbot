# Configuração Geral do Servidor
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Conexão PostgreSQL (com suporte a pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bookchatbot
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000

# Conexão Exclusiva para Benchmark RAG / PostgreSQL (Homologação / Staging)
# AVISO OPERACIONAL CRÍTICO:
# - Deve apontar EXCLUSIVAMENTE para banco de staging/homologação.
# - NUNCA apontar para o banco DATABASE_URL de produção.
# - O benchmark executa consultas com EXPLAIN (ANALYZE, BUFFERS) em transações READ ONLY.
RAG_BENCHMARK_DATABASE_URL=postgresql://bookchatbot:bookchatbot_staging_local@127.0.0.1:5433/bookchatbot_staging

# Google Gemini API
GEMINI_API_KEY=sua_chave_aqui
GEMINI_GENERATIVE_MODEL=gemini-3.8-flash
GENERATION_TIMEOUT_MS=30000

# Diretório Local para Arquivos de Livros
BOOKS_STORAGE_DIR=./storage/books

# Parâmetros de Ingestão e RAG
EMBEDDING_CONCURRENCY=3
RAG_CANDIDATE_K=20
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.35
MAX_QUERY_CHARS=4000
MAX_CONTEXT_CHARS=25000

# Limites e Timeouts HTTP Fastify
HTTP_HANDLER_TIMEOUT_MS=45000
HTTP_BODY_LIMIT_BYTES=1048576
HTTP_JSON_BODY_LIMIT_BYTES=65536

# Rate Limiting (requisições por minuto por IP)
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_SEARCH_MAX=60
RATE_LIMIT_INGEST_MAX=5
RATE_LIMIT_BOOKS_MAX=60

# CORS (origens permitidas para acesso de interfaces web, separadas por vírgula)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Limite Máximo de Upload para Arquivos TXT (bytes - padrão: 5MB)
MAX_UPLOAD_FILE_SIZE_BYTES=5242880

# Controle de Taxa de Embeddings (TPM - Tokens Por Minuto) e Worker de Ingestão
# Limite conservador de tokens por minuto (Gemini Free: 30.000 TPM; default recomendado: 20.000 TPM)
GEMINI_EMBEDDING_TPM_LIMIT=20000
INGESTION_WORKER_ENABLED=true
INGESTION_WORKER_POLL_INTERVAL_MS=2000
INGESTION_JOB_MAX_ATTEMPTS=5
